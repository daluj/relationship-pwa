{
  "name": "Kin — personal CRM",
  "short_name": "Kin",
  "description": "A private, offline-first journal for the people in your life. Your data never leaves this device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#14B8A6",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log moment",
      "url": "/compose",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Reminders",
      "url": "/reminders",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Search",
      "url": "/search",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            ".vcf",
            ".vcard",
            "text/vcard",
            "text/x-vcard",
            ".json",
            "application/json",
            ".csv",
            "text/csv",
            ".ics",
            "text/calendar"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/settings/data",
      "accept": {
        "text/vcard": [".vcf", ".vcard"],
        "application/json": [".json"],
        "text/csv": [".csv"],
        "text/calendar": [".ics"]
      }
    }
  ]
}
