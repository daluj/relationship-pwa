    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.30.6",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
